from fastapi.testclient import TestClient
from main import app

client = TestClient(app)

def test_category_by_post():

    cat_response = client.post("/categories", json={"name": "Tools"})
    assert cat_response.status_code == 200
    cat = cat_response.json()

    response = client.post("/products", json={
        "name": "Shovel",
        "unit": "each",
        "cost_per_unit": 10,
        "price_per_unit": 15,
        "quantity_in_stock": 20,
        "category_id": cat["id"]
    })

    assert response.status_code == 201
    data = response.json()

    assert data["name"] == "Shovel"
    assert data["unit"] == "each"
    assert data["cost_per_unit"] == 10
    assert data["price_per_unit"] == 15
    assert data["quantity_in_stock"] == 20

    assert data["category"]["id"] == cat["id"]
    assert data["category"]["name"] == "Tools"